---
import Layout from '../../layouts/Layout.astro'
import { GUIDES } from '../../data/guides'
---

<Layout
  title="Guides | MM2Shark"
  description="Short MM2 notes — summer event, how trading works, and common scams."
>
  <article class="guide-index">
    <header class="legal-head">
      <p class="legal-kicker">Guides</p>
      <h1>Guides</h1>
      <p>Short notes. Values and the calculator stay on their own pages.</p>
    </header>

    <div class="strips guide-strips">
      {
        GUIDES.map((g) => (
          <a class="strip" href={`/guides/${g.slug}/`}>
            <strong>{g.kicker}</strong>
            <p>
              <span class="guide-strip-title">{g.title}</span>
              {g.teaser}
            </p>
            <em>Read →</em>
          </a>
        ))
      }
    </div>
  </article>
</Layout>
