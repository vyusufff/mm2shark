---
import Layout from '../../layouts/Layout.astro'
import { GUIDES, guideBySlug } from '../../data/guides'

export function getStaticPaths() {
  return GUIDES.map((g) => ({
    params: { slug: g.slug },
    props: { slug: g.slug },
  }))
}

const { slug } = Astro.props
const guide = guideBySlug(slug)!
const title = `${guide.title} | MM2Shark`
---

<Layout title={title} description={guide.description}>
  <article class="guide-page">
    <nav class="item-crumb" aria-label="Breadcrumb">
      <a href="/guides/">Guides</a>
      <span aria-hidden="true">/</span>
      <span>{guide.kicker}</span>
    </nav>

    <header class="legal-head">
      <p class="legal-kicker">{guide.kicker}</p>
      <h1>{guide.title}</h1>
    </header>

    {
      guide.sections.map((section) => (
        <section class="guide-section">
          <h2>{section.h2}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          {section.bullets && section.bullets.length > 0 && (
            <ul>
              {section.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <p class="guide-foot">
      <a href="/values/">Value list</a>
      <span aria-hidden="true">·</span>
      <a href="/calculator/">Calculator</a>
      <span aria-hidden="true">·</span>
      <a href="/guides/">All guides</a>
    </p>
  </article>
</Layout>
