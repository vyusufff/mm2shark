---
import Layout from '../../layouts/Layout.astro'
import { GUIDES, guideBySlug } from '../../data/guides'

export function getStaticPaths() {
  return GUIDES.map((g) => ({
    params: { slug: g.slug },
    props: { slug: g.slug },
  }))
}

const { slug } = Astro.props
const guide = guideBySlug(slug)!
const title = `${guide.title} | MM2Shark`
---

<Layout title={title} description={guide.description}>
  <article class="guide-page">
    <nav class="item-crumb" aria-label="Breadcrumb">
      <a href="/guides/">Guides</a>
      <span aria-hidden="true">/</span>
      <span>{guide.kicker}</span>
    </nav>

    <header class="legal-head">
      <p class="legal-kicker">{guide.kicker}</p>
      <h1>{guide.title}</h1>
      <p class="guide-lead">{guide.teaser}</p>
      <div class="item-actions guide-actions">
        <a class="btn btn-primary" href="/values/">Open Value List</a>
        <a class="btn btn-ghost" href="/calculator/">Trade Calculator</a>
      </div>
    </header>

    {
      guide.sections.map((section) => (
        <section class="guide-section">
          <h2>{section.h2}</h2>
          {section.paragraphs.map((p) => (
            <p>{p}</p>
          ))}
          {section.bullets && section.bullets.length > 0 && (
            <ul>
              {section.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    <section class="guide-cta">
      <h2>Check the numbers</h2>
      <p>Done reading? Look up the items, then compare both sides.</p>
      <div class="item-actions">
        <a class="btn btn-primary" href="/values/">Value List</a>
        <a class="btn btn-ghost" href="/calculator/">Calculator</a>
      </div>
    </section>
  </article>
</Layout>
