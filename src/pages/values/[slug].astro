---
import ItemValuePage from '../../components/ItemValuePage.astro'
import ValuesHubBrowse from '../../components/ValuesHubBrowse.astro'
import { SLUG_ENTRIES } from '../../data/slugs'
import { VALUE_HUBS, HUB_SLUGS } from '../../data/hubs'
import type { Mm2Item } from '../../data/catalog'
import type { ValueHub } from '../../data/hubs'

export function getStaticPaths() {
  const hubs = VALUE_HUBS.map((hub) => ({
    params: { slug: hub.slug },
    props: { mode: 'hub' as const, hub },
  }))

  const items = SLUG_ENTRIES.filter(({ slug }) => !HUB_SLUGS.has(slug)).map(({ slug, item }) => ({
    params: { slug },
    props: { mode: 'item' as const, item },
  }))

  return [...hubs, ...items]
}

type Props = { mode: 'hub'; hub: ValueHub } | { mode: 'item'; item: Mm2Item }

const props = Astro.props as Props
---

{props.mode === 'hub' ? <ValuesHubBrowse hub={props.hub} /> : <ItemValuePage item={props.item} />}
