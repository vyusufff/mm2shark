---
import Layout from '../../layouts/Layout.astro'
import { ValueList } from '../../components/react/ValueList'
import { seoMonthYear } from '../../data/seo'
import { ITEMS_META } from '../../data/items'

const month = seoMonthYear()
const count = ITEMS_META.count || 0
---

<Layout
  title={`MM2 Values List (${month}) — Updated Daily | MM2Shark`}
  description={`Complete Murder Mystery 2 value list (${count}+ items) with demand. Browse godlies, chromas, ancients, pets, and sets. Free trade calculator. Updated regularly.`}
>
  <ValueList client:load />
</Layout>
