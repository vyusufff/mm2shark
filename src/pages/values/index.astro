---
import Layout from '../../layouts/Layout.astro'
import { ValueList } from '../../components/react/ValueList'
import { ITEMS_META } from '../../data/items'

const count = ITEMS_META.count || 0
---

<Layout
  title="MM2Shark Value List — Knives, Guns, Godlies & More"
  description={`MM2Shark value list for Murder Mystery 2 — ${count}+ items with demand. Browse godlies, chromas, ancients, pets, and sets, then open the trade calculator.`}
>
  <ValueList client:load />
</Layout>
