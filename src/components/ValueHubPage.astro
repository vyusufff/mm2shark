---
import Layout from '../layouts/Layout.astro'
import { ITEMS_META } from '../data/items'
import { itemHref } from '../data/slugs'
import { VALUE_HUBS, hubHref, hubStats, itemsForHub, type ValueHub } from '../data/hubs'
import { formatAvg, formatValue, seoMonthYear } from '../data/seo'

interface Props {
  hub: ValueHub
}

const { hub } = Astro.props
const month = seoMonthYear()
const list = itemsForHub(hub).sort((a, b) => b.value - a.value)
const stats = hubStats(list)
const title = `${hub.label} MM2 Values (${month}) — Full List | MM2Shark`
const description = `${hub.plural} Murder Mystery 2 values — ${stats.count} items, avg ${formatAvg(stats.avg)}, top ${formatValue(stats.max)}. Updated regularly. Free trade calculator.`
const otherHubs = VALUE_HUBS.filter((h) => h.slug !== hub.slug)
const origin = Astro.site?.toString().replace(/\/$/, '') || 'https://mm2shark.com'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${hub.label} MM2 Values`,
  numberOfItems: stats.count,
  itemListElement: list.slice(0, 50).map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    url: `${origin}${itemHref(item)}`,
  })),
}
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <article class="hub-page">
    <nav class="item-crumb" aria-label="Breadcrumb">
      <a href="/values/">Value List</a>
      <span aria-hidden="true">/</span>
      <span>{hub.plural}</span>
    </nav>

    <header class="hub-hero">
      <p class="legal-kicker">{month} · Updated regularly</p>
      <h1>{hub.label} MM2 Values</h1>
      <p class="hub-lead">{hub.lead}</p>
      <div class="hub-stats" aria-label="Hub stats">
        <div>
          <strong>{stats.count}</strong>
          <span>Valued items</span>
        </div>
        <div>
          <strong>{formatAvg(stats.avg)}</strong>
          <span>Average</span>
        </div>
        <div>
          <strong>{formatValue(stats.max)}</strong>
          <span>Highest</span>
        </div>
      </div>
      <div class="item-actions">
        <a class="btn btn-primary" href="/calculator/">Trade Calculator</a>
        <a class="btn btn-ghost" href="/values/">Full value list</a>
      </div>
    </header>

    {
      stats.top.length > 0 && (
        <section class="hub-section">
          <h2>Most valuable {hub.plural.toLowerCase()}</h2>
          <div class="hub-top-grid">
            {stats.top.map((item, i) => (
              <a class="hub-top-card" href={itemHref(item)}>
                <em>#{i + 1}</em>
                {item.image ? (
                  <img src={item.image} alt="" width={56} height={56} loading="lazy" />
                ) : (
                  <span class="hub-top-empty">?</span>
                )}
                <span>
                  <strong>{item.name}</strong>
                  <small>
                    {item.rarity} · {item.type}
                  </small>
                </span>
                <b>{formatValue(item.value)}</b>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="hub-section">
      <h2>All {hub.plural} ({stats.count})</h2>
      <div class="hub-item-grid">
        {
          list.map((item) => (
            <a class="hub-item-card" href={itemHref(item)}>
              {item.image ? (
                <img src={item.image} alt="" width={48} height={48} loading="lazy" />
              ) : (
                <span>?</span>
              )}
              <span>
                <strong>{item.name}</strong>
                <small>
                  {item.rarity} · {item.type}
                </small>
              </span>
              <b>{formatValue(item.value)}</b>
            </a>
          ))
        }
      </div>
    </section>

    <section class="hub-section hub-about">
      <h2>About {hub.label} items in Murder Mystery 2</h2>
      <p>{hub.about}</p>
      <p>
        There are currently <strong>{stats.count}</strong> valued {hub.plural.toLowerCase()} on
        MM2Shark
        {
          stats.count > 0 && (
            <>
              , with an average of <strong>{formatAvg(stats.avg)}</strong> and a high of{' '}
              <strong>{formatValue(stats.max)}</strong>
              {stats.top[0] && <> ({stats.top[0].name})</>}
            </>
          )
        }. Values are community trading references and update from public market data
        {
          ITEMS_META.updatedAt && (
            <>
              {' '}
              (last sync{' '}
              {new Date(ITEMS_META.updatedAt).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'short',
                day: 'numeric',
              })}
              )
            </>
          )
        }.
      </p>
      <p>
        Check fairness with the <a href="/calculator/">MM2 trade calculator</a> or return to the{' '}
        <a href="/values/">full MM2 value list</a>.
      </p>
    </section>

    <section class="hub-section">
      <h2>Browse MM2 values by category</h2>
      <div class="hub-other">
        {otherHubs.map((h) => <a href={hubHref(h)}>{h.plural}</a>)}
      </div>
    </section>
  </article>
</Layout>
