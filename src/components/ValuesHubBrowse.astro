---
import Layout from '../layouts/Layout.astro'
import { ValueList } from './react/ValueList'
import { itemsForHub, hubStats, type ValueHub } from '../data/hubs'
import { formatAvg, formatValue } from '../data/seo'
import { itemHref } from '../data/slugs'

interface Props {
  hub: ValueHub
}

const { hub } = Astro.props
const list = itemsForHub(hub).sort((a, b) => b.value - a.value)
const stats = hubStats(list)
const title = `MM2Shark — ${hub.label} Values`
const description = `MM2Shark ${hub.plural.toLowerCase()} list — ${stats.count} items, avg ${formatAvg(stats.avg)}, top ${formatValue(stats.max)}. ${hub.about}`
const origin = Astro.site?.toString().replace(/\/$/, '') || 'https://mm2shark.com'
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `${hub.label} MM2 Values`,
  description: hub.about,
  numberOfItems: stats.count,
  itemListElement: list.slice(0, 40).map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    url: `${origin}${itemHref(item)}`,
  })),
}
---

<Layout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <ValueList client:load initialFilter={hub.id} />
</Layout>
